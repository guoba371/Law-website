# 站点对外地址。影响 canonical、og:url、站点地图和 robots.txt，改完必须重新构建。
# 本地测试可以保持默认的 https://example.com，部署时改成真实域名。
SITE_URL=https://www.example.com

# 后台登录密码。不设置就用内置初始密码 lawfirm2026，上线前必须改掉。
ADMIN_PASSWORD=change-me-before-launch

# 前台当前渲染的站点 ID，站群上线时每个站点各构建一次。默认 1（主站）。
SITE_ID=1

# 咨询提交后的通知渠道，两个都可不配置，不配置对应渠道就静默跳过。
# 钉钉群机器人（加签方式，可选 secret）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 邮件 SMTP。建议用国内企业邮箱，发到律所负责人的邮箱。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# 服务监听地址，不设置时分别用 4321 和 0.0.0.0
PORT=4321
HOST=0.0.0.0
